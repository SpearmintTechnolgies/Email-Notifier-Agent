# Copy to .env (same folder as this file, or $MAILOPS_HOME/.env) and fill in.
# .env is gitignored - never commit it.

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Seed allowlist (comma-separated numeric Telegram user ids). On first launch
# these are copied into data/ops.db. After that, owners manage access from the
# private Admin panel — no .env edit or restart is required to add/remove people.
# Empty = nobody (fail closed). Self-registration is disabled.
TELEGRAM_ALLOWED_USERS=
# Optional bootstrap owner (fixed, cannot be removed). Default: first ALLOWED_USERS id.
TELEGRAM_OWNER_ID=
# Optional: chat ids that receive push notifications, comma-separated
# (defaults to first allowed user). Positive = private chat, negative = group,
# e.g. TELEGRAM_HOME_CHANNEL=123456789,-1001234567890
# Negative ids are also the first-launch group whitelist (copied into ops.db).
# The bot must be a member of the group. In the group, an authorized user can
# send /chatid@<your_bot_username> to learn the group's id (it may change from
# -123... to -100... if Telegram upgrades the group to a supergroup).
# Group dashboards only work for whitelisted groups AND individually authorized users.
TELEGRAM_HOME_CHANNEL=

# --- LLM (classification + AI drafts) ---
# Any OpenAI-compatible /v1 chat/completions endpoint (OpenAI, Groq, local proxy).
# Leave OPENAI_API_KEY empty to run keyword rules only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required when the host is api.openai.com (model=auto is rejected there).
# Groq example: OPENAI_BASE_URL=https://api.groq.com/openai/v1
#               OPENAI_MODEL=openai/gpt-oss-20b
# If OPENAI_API_KEY is empty and the host is groq.com, Mailops uses GROQ_API_KEY
# from the process environment and does not write that key into this file.
# OPENAI_MODEL=gpt-4o-mini

# --- Google OAuth2 (Gmail via Himalaya) - NOT used by the Altcoin-Informer-only deployment ---
# Leave empty unless you re-activate a Gmail inbox; see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Safety ---
# 1 = block ALL mutating mailbox operations and sends (safe test mode)
MAILOPS_TEST_MODE=0

# --- Secure mobile onboarding (optional) ---
# Set MAILOPS_WEB_ENABLE=1 to start the loopback HTTPS onboarding server
# inside the bot process. The server binds to 127.0.0.1 only; a reverse
# tunnel (Cloudflare, Tailscale Funnel, etc. — see docs/REMOTE_ONBOARDING.md)
# is responsible for terminating public TLS and reaching the phone.
# MAILOPS_WEB_PUBLIC_URL is the HTTPS URL that the Telegram client will
# load as a Mini App; it must match the Mini App URL you set with @BotFather
# (`/newapp`) so that initData validation can succeed.
MAILOPS_WEB_ENABLE=0
MAILOPS_WEB_PUBLIC_URL=
# Local TCP port on 127.0.0.1 that the loopback server listens on.
# MAILOPS_WEB_PORT=8738
# Secrets vault: on Windows DPAPI (CurrentUser) is used automatically. On
# Linux / CI a Fernet key is created under %LOCALAPPDATA%\Mailops\keys\ or
# ~/.config/mailops/keys/; override that path with MAILOPS_KEY_DIR.
# MAILOPS_KEY_DIR=
# MAILOPS_FORCE_SOFT_VAULT=0

# --- Bulk CSV mailbox onboarding ---
# Only administrators (TELEGRAM_ALLOWED_USERS with the 'admin' permission) may
# start a bulk import. The CSV upload itself is accepted in a WHITELISTED
# group only when BOTH:
#   1) MAILOPS_BULK_ALLOW_GROUP_UPLOAD=1   AND
#   2) the chat id matches MAILOPS_BULK_ALLOWED_GROUP (or MAILOPS_BULK_ALLOWED_GROUP
#      is empty and the chat is on the general TELEGRAM_HOME_CHANNEL allowlist).
# The uploader is loudly warned that group members may have seen the file
# before the bot could delete it. The bot deletes the uploaded document
# message best-effort and reports if deletion fails.
MAILOPS_BULK_ALLOW_GROUP_UPLOAD=0
MAILOPS_BULK_ALLOWED_GROUP=
# Hard caps enforced before any row is validated (defence against runaway files).
MAILOPS_BULK_MAX_ROWS=1000
MAILOPS_BULK_MAX_FILE_BYTES=2097152
MAILOPS_BULK_MAX_LINE_BYTES=4096
# Bounded concurrency for IMAP+SMTP validation. Keep these modest on a laptop.
MAILOPS_BULK_WORKERS=6
MAILOPS_BULK_PER_HOST=3
MAILOPS_BULK_HOST_RATE_PER_SEC=2
# Default activation for newly registered mailboxes:
#   'inactive'  - registered, organize OFF, send OFF, NOT polled (recommended)
#   'ask'       - the UI prompts per import (default)
# Monitoring can always be activated later via Mailboxes -> Activate Monitoring.
MAILOPS_BULK_DEFAULT_ACTIVATION=ask

# --- Optional overrides ---
# HIMALAYA_BIN=C:\path\to\himalaya.exe
# MAILOPS_HOME=C:\path\to\profile   (where .env + himalaya config live)
# MAILOPS_HIMALAYA_DIR=C:\path\to\himalaya-config
