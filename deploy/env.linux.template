# Mailops - Linux (.env) TEMPLATE. Copy to /opt/mailops/.env, chmod 600,
# chown mailops:mailops, then fill in. NEVER commit a filled copy.
#
#   install -o mailops -g mailops -m 600 deploy/env.linux.template /opt/mailops/.env
#
# This template contains NO secret values. Every key that holds a secret on
# the Windows host is left deliberately EMPTY here and must be re-entered on
# the Linux host by the operator (or sourced from AWS SSM/Secrets Manager).

# --- Telegram bot ------------------------------------------------------------
# Same token as the Windows deployment. CRITICAL: only ONE process may poll a
# given token at a time. Do not fill this in until the Windows bot is stopped
# at cutover, or Telegram will return "Conflict: terminated by other
# getUpdates request" and notifications will be dropped on both sides.
TELEGRAM_BOT_TOKEN=
# Seed allowlist (comma-separated numeric Telegram user ids). Copied into
# data/ops.db on first launch only; afterwards managed from the Admin panel.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_OWNER_ID=
# Negative ids are group chats and are ALSO the first-launch group whitelist.
TELEGRAM_HOME_CHANNEL=

# --- LLM (classification + AI drafts) ---------------------------------------
# Leave OPENAI_API_KEY empty to run keyword rules only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- Google OAuth2 (Gmail via Himalaya) - not used by this deployment -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Safety ------------------------------------------------------------------
# 1 = block ALL mutating mailbox operations and sends. KEEP THIS AT 1 for the
# first Linux boot, the himalaya smoke test and the acceptance run. Flip to 0
# only after the install is verified and the Windows bot has been stopped.
MAILOPS_TEST_MODE=1

# --- Linux paths (differ from Windows) --------------------------------------
# Absolute path to the Linux himalaya binary (x86_64-unknown-linux-gnu build).
# Leave empty to resolve via PATH.
HIMALAYA_BIN=/usr/local/bin/himalaya
# Profile dir holding .env, himalaya/, tokens/, secrets/.
MAILOPS_HOME=/opt/mailops
MAILOPS_HIMALAYA_DIR=/opt/mailops/himalaya

# --- Secrets vault -----------------------------------------------------------
# "file"  = local DPAPI(Windows)/Fernet(Linux) wrapped blobs under secrets/
# "ssm"   = AWS SSM Parameter Store SecureString + KMS  (requires boto3)
# The Windows .enc blobs are DPAPI-sealed and CANNOT be decrypted on Linux;
# see docs/AWS_CREDENTIAL_MIGRATION_PLAN.md before choosing.
MAILOPS_VAULT_BACKEND=file
# MAILOPS_SSM_PREFIX=/mailops/secrets
# MAILOPS_SSM_KMS_KEY_ID=alias/mailops-secrets
# AWS_REGION=us-east-1
#
# file backend only: where the Fernet master key is created. MUST be set to an
# absolute path on Linux, because mailops/himalaya_client.py overrides HOME for
# the himalaya child process (so the `get-secret` child would otherwise resolve
# ~/.config/mailops/keys to $MAILOPS_HOME/.config/... while the bot itself used
# the service user's real home). Setting this makes both agree.
MAILOPS_KEY_DIR=/opt/mailops/keys
# MAILOPS_FORCE_SOFT_VAULT=0

# --- Credential entry policy -------------------------------------------------
# 1 = allow IMAP/SMTP passwords to be typed in a private DM with the bot.
MAILOPS_ALLOW_DM_CREDENTIALS=0

# --- Secure mobile onboarding (optional) ------------------------------------
MAILOPS_WEB_ENABLE=0
MAILOPS_WEB_PUBLIC_URL=
# MAILOPS_WEB_PORT=8738

# --- Bulk CSV mailbox onboarding --------------------------------------------
MAILOPS_BULK_ALLOW_GROUP_UPLOAD=0
MAILOPS_BULK_ALLOWED_GROUP=
MAILOPS_BULK_MAX_ROWS=1000
MAILOPS_BULK_MAX_FILE_BYTES=2097152
MAILOPS_BULK_MAX_LINE_BYTES=4096
MAILOPS_BULK_WORKERS=6
MAILOPS_BULK_PER_HOST=3
MAILOPS_BULK_HOST_RATE_PER_SEC=2
MAILOPS_BULK_DEFAULT_ACTIVATION=ask

# --- Optional: MX-based autoconfig (needs dnspython) ------------------------
# MAILOPS_AUTOCONFIG_MX=0
